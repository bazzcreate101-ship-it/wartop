NODE_ENV=production
APP_URL=https://wartop.shop

DB_HOST=localhost
DB_PORT=3306
DB_NAME=wartopsh_wartop
DB_USER=wartopsh_wartop
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=5

# Use ADMIN_PASSWORD_HASH in preference to ADMIN_PASSWORD when possible.
# Generate it locally with: node -e "import('bcryptjs').then(({default:b})=>console.log(b.hashSync('replace-me',12)))"
ADMIN_PASSWORD=change-me
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=generate-a-different-long-random-secret
USER_SESSION_SECRET=generate-another-long-random-secret
TRAFFIC_HASH_SECRET=generate-another-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://wartop.shop/api/auth/google/callback

PREMZONE_API_KEY=change-me
PREMZONE_MODEL=gpt-5.5
